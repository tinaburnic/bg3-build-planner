@model BG3BuildPlanner.Models.Skill.SkillEditModel

@{
    ViewData["Title"] = "Edit Skill";
}

<section class="skill-edit-shell reveal-up" aria-label="Edit Skill">
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <div class="skill-edit-header">
        <p class="section-label">Update Arcane</p>
        <h1 class="skill-edit-title">Edit Skill</h1>
    </div>

    <form asp-action="Edit" method="post" class="skill-edit-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        
        <input type="hidden" asp-for="Id" />
        
        <div class="form-group">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="RequiredLevel" class="form-label"></label>
            <input asp-for="RequiredLevel" class="form-control" type="number" min="1" max="20" />
            <span asp-validation-for="RequiredLevel" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ImageUrl" class="form-label"></label>
            <input asp-for="ImageUrl" class="form-control" />
            <span asp-validation-for="ImageUrl" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-gold">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-outline-gold">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
