@using System.Linq
@model BG3BuildPlanner.Data.User

@{
    ViewData["Title"] = Model.Username;
    var portraitUrl = Url.Content("~/images/characters/placeholder.svg");
    var buildCount = Model.Builds?.Count ?? 0;
    var ratingCount = Model.Ratings?.Count ?? 0;
}

<section class="character-detail-shell reveal-up" aria-label="User Detail">
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <p class="section-label">User Profile</p>
    <h1 class="character-detail-title">@Model.Username</h1>

    <div class="character-detail-layout">
        <figure class="character-portrait-panel">
            <img src="@portraitUrl" alt="Portrait for @Model.Username" class="character-portrait-image" />
        </figure>

        <article class="character-detail-card" aria-label="User Summary">
            <header class="character-detail-card-header">
                <p class="section-label mb-1">Details</p>
                <h2>@Model.Username</h2>
            </header>

            <dl class="character-stat-table">
                <div class="character-stat-row">
                    <dt>Builds</dt>
                    <dd>@buildCount</dd>
                </div>
                <div class="character-stat-row">
                    <dt>Ratings</dt>
                    <dd>@ratingCount</dd>
                </div>
            </dl>

            <a asp-action="Index" class="btn btn-outline-gold character-detail-back">Back to Users</a>
        </article>
    </div>

    <div class="build-sub-section">
        <h3>Builds</h3>
        @if (buildCount == 0)
        {
            <p>No builds recorded yet.</p>
        }
        else
        {
            <ul>
            @foreach (var build in Model.Builds.OrderBy(b => b.Title))
            {
                <li>
                    <a asp-controller="Build" asp-action="Details" asp-route-id="@build.Id">@build.Title</a>
                </li>
            }
            </ul>
        }
    </div>

    <div class="build-sub-section">
        <h3>Ratings</h3>
        @if (ratingCount == 0)
        {
            <p>No ratings submitted yet.</p>
        }
        else
        {
            <ul>
            @foreach (var rating in Model.Ratings.Where(r => r.Build != null).OrderByDescending(r => r.CreatedAt))
            {
                var buildTitle = rating.Build?.Title ?? "Unknown build";
                <li>
                    <strong>@rating.Score/5</strong> - @rating.Comment (on @buildTitle)
                </li>
            }
            </ul>
        }
    </div>
</section>
