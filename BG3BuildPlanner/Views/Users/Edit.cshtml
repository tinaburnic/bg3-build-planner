@model BG3BuildPlanner.Models.User.UserEditModel

@{
    bool isOwnProfile = ViewData["IsOwnProfile"] as bool? ?? false;
    ViewData["Title"] = isOwnProfile ? "Edit Your Profile" : "Edit User";
    string sectionLabel = isOwnProfile ? "Your Account" : "Update Scribe";
    string heading = isOwnProfile ? "Edit Your Profile" : "Edit User";
}

<section class="character-create-shell reveal-up" aria-label="@heading">
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <div class="character-create-header">
        <p class="section-label">@sectionLabel</p>
        <h1 class="character-create-title">@heading</h1>
        @if (isOwnProfile)
        {
            <p class="character-index-lead">Update your username, email, or password. Leave the password fields blank to keep your current password.</p>
        }
    </div>

    <form asp-action="Edit" method="post" class="character-create-form">
        <input asp-for="Id" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="form-group">
            <label asp-for="Username" class="profile-edit-label">Username</label>
            <input asp-for="Username" class="profile-edit-input" autocomplete="username" />
            <span asp-validation-for="Username" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Email" class="profile-edit-label">Email</label>
            <input asp-for="Email" class="profile-edit-input" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <fieldset class="profile-edit-password-section">
            <legend class="profile-edit-label">Change Password <span class="profile-edit-optional">(optional — leave blank to keep current)</span></legend>

            <div class="form-group">
                <label asp-for="NewPassword" class="profile-edit-label">New Password</label>
                <input asp-for="NewPassword" class="profile-edit-input" type="password" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="profile-edit-label">Confirm New Password</label>
                <input asp-for="ConfirmPassword" class="profile-edit-input" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn-gold">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-outline-gold">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
