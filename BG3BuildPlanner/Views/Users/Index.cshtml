@using System.Collections.Generic
@using System.Linq
@model IEnumerable<BG3BuildPlanner.Data.User>

@{
    ViewData["Title"] = "Users";
}

<section class="user-index-shell reveal-up"
         aria-label="User Index"
         data-live-search
         data-live-search-input="#user-search-input"
         data-live-search-id-input="#user-search-id"
         data-live-search-results="[data-user-grid]"
         data-live-search-empty="[data-user-empty]"
         data-live-search-url="@Url.Action("Search", "Users")"
         data-live-search-renderer="renderUserCard"
         data-live-search-debounce="250">
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <p class="section-label">Adventurer Registry</p>
    <h1 class="user-index-title">Oathbound Dossiers</h1>
    <p class="user-index-lead">
        Each oathbound chronicler leaves a trail of builds behind them. Track their craft, review their choices,
        and dive into the tactical legacy they have forged.
    </p>

    <div class="user-index-actions">
        <a asp-action="Create" class="btn-gold">Create New User</a>
    </div>

    <div class="user-search" aria-label="Search users">
        @await Html.PartialAsync("_AutocompleteInput", new BG3BuildPlanner.Models.Shared.AutocompleteInputModel
        {
            InputId = "user-search-input",
            InputName = "UserSearch",
            HiddenInputId = "user-search-id",
            HiddenInputName = "UserId",
            Label = "Search by username",
            Placeholder = "Type a username",
            EndpointUrl = Url.Action("Autocomplete", "Users") ?? string.Empty,
            MinLength = 2
        })
        <span class="user-search-hint">Live search updates the registry as you type.</span>
    </div>

    <div class="user-grid" data-user-grid data-reveal-container>
        @foreach (var user in Model)
        {
            var activeBuilds = user.Builds?.Where(b => b.DeletedAt == null).ToList() ?? new List<BG3BuildPlanner.Data.Build>();
            var buildCount = activeBuilds.Count;

            <article class="user-card" aria-label="@user.Username profile" data-reveal-item>
                <a class="user-card-link" asp-action="Details" asp-route-id="@user.Id" aria-label="View @user.Username profile"></a>
                <header class="user-card-header">
                    <h2 class="user-name">@user.Username</h2>
                </header>
                <div class="user-card-body">
                    <div class="user-detail"><span class="detail-label">Builds</span> @buildCount build@(buildCount == 1 ? string.Empty : "s")</div>
                    <div class="user-detail user-detail--builds">
                        <span class="detail-label">Build List</span>
                        @if (buildCount == 0)
                        {
                            <div class="user-build-empty">No builds recorded yet. The campfire still waits.</div>
                        }
                        else
                        {
                            <div class="user-builds">
                                @foreach (var build in activeBuilds.OrderBy(b => b.Title))
                                {
                                    <a asp-controller="Build" asp-action="Details" asp-route-id="@build.Id" class="user-build-badge">
                                        @build.Title
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    <p class="user-empty" data-user-empty hidden>No users match this search.</p>
</section>
