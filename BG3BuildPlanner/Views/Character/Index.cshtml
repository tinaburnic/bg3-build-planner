@model IEnumerable<BG3BuildPlanner.Data.Character>

@{
    ViewData["Title"] = "Characters";
}

<section class="character-index-shell reveal-up"
         aria-label="Character Index"
         data-live-search
         data-live-search-input="#character-search-input"
         data-live-search-id-input="#character-search-id"
         data-live-search-results="[data-character-grid]"
         data-live-search-empty="[data-character-empty]"
         data-live-search-url="@Url.Action("Search", "Character")"
         data-live-search-renderer="renderCharacterCard"
         data-live-search-debounce="250">
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <p class="section-label">Key Companions</p>
    <h1 class="character-index-title">Character Roster</h1>
    <p class="character-index-lead">
        Browse each companion and inspect core traits before jumping into full build details.
        Every profile links directly to a deeper tactical breakdown.
    </p>
    <div class="character-index-actions">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn-gold">Create New Character</a>
        }
    </div>

    <div class="character-search" aria-label="Search characters">
        @await Html.PartialAsync("_AutocompleteInput", new BG3BuildPlanner.Models.Shared.AutocompleteInputModel
        {
            InputId = "character-search-input",
            InputName = "CharacterSearch",
            HiddenInputId = "character-search-id",
            HiddenInputName = "CharacterId",
            Label = "Search by name",
            Placeholder = "Type a character name",
            EndpointUrl = Url.Action("Autocomplete", "Character") ?? string.Empty,
            MinLength = 2
        })
        <span class="character-search-hint">Live search updates the roster as you type.</span>
    </div>

    <div class="character-grid" data-character-grid data-reveal-container>
        @foreach (var character in Model)
        {
            <a asp-action="Details" asp-route-id="@character.Id" class="character-card-link" aria-label="View details for @character.Name">
                <article class="character-card" data-reveal-item>
                    <header class="character-card-header">
                        <h2 class="character-name">@character.Name</h2>
                    </header>
                    <div class="character-card-body">
                        <div class="character-detail"><span class="detail-label">Race</span> @character.Race</div>
                        <div class="character-detail"><span class="detail-label">Background</span> @character.Background</div>
                        <div class="character-detail"><span class="detail-label">Level</span> @character.Level</div>
                    </div>
                </article>
            </a>
        }
    </div>

    <p class="character-empty" data-character-empty hidden>No characters match this search.</p>
</section>

