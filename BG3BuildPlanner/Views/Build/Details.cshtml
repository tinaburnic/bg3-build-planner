@model BG3BuildPlanner.Data.Build

@{
    ViewData["Title"] = "Build Details";
    var characterName = string.IsNullOrWhiteSpace(Model.Character?.Name)
        ? "Unknown"
        : Model.Character.Name;
    var creatorName = string.IsNullOrWhiteSpace(Model.User?.Username)
        ? "Unknown"
        : Model.User.Username;
    var difficultyImage = Model.Difficulty switch
    {
        Difficulty.Explorer => "Explorer_Difficulty.jpg",
        Difficulty.Balanced => "Balanced_Difficulty.jpg",
        Difficulty.Tactician => "Tactician_Difficulty.jpg",
        _ => "Balanced_Difficulty.jpg"
    };
}

<section class="build-detail-shell reveal-up fade-remove-target" aria-label="Build Details" data-remove-target>
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <p class="section-label">Build Breakdown</p>
    <h1 class="build-detail-title">@Model.Title</h1>

    <div class="build-detail-layout">
        <figure class="build-difficulty-panel">
            <img src="@Url.Content($"~/images/builds/{difficultyImage}")" alt="Image representing @Model.Difficulty difficulty" class="build-difficulty-image" />
            <figcaption class="build-difficulty-caption">@Model.Difficulty Difficulty</figcaption>
        </figure>

        <article class="build-detail-card" aria-label="Build Stats">
            <header class="build-detail-card-header">
                <p class="section-label mb-1">Details</p>
                <h2>@Model.Title</h2>
            </header>

            <dl class="build-stat-table">
                <div class="build-stat-row">
                    <dt>Description</dt>
                    <dd>@Model.Description</dd>
                </div>
                <div class="build-stat-row">
                    <dt>Difficulty</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div class="build-stat-row">
                    <dt>Character</dt>
                    <dd>@characterName</dd>
                </div>
                <div class="build-stat-row">
                    <dt>Created By</dt>
                    <dd>
                        @if (Model.User != null)
                        {
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.User.Id">@creatorName</a>
                        }
                        else
                        {
                            @creatorName
                        }
                    </dd>
                </div>
                <div class="build-stat-row">
                    <dt>Created</dt>
                    <dd>@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                </div>
            </dl>
            <div class="build-detail-actions">
                @{
                    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                    var isOwner = currentUserId == Model.UserId.ToString();
                    var canEditBuild = User.IsInRole("Admin") || isOwner;
                }
                @if (canEditBuild)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-gold">Edit Build</a>
                }
                @if (User.IsInRole("Admin") || isOwner)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="build-detail-delete" data-delete-form data-delete-target=".build-detail-shell">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-outline-gold" onclick="return confirm('Delete this build?');">Delete Build</button>
                    </form>
                }
                <a asp-action="Index" class="btn-outline-gold">Back to Build List</a>
            </div>
        </article>
    </div>

    <div class="build-sub-section">
        <h3>Skills</h3>
        <ul>
        @foreach (var skill in Model.Skills)
        {
            <li>@skill.Name (Level @skill.RequiredLevel)</li>
        }
        </ul>
    </div>

    <div class="build-sub-section">
        <h3>Items</h3>
        <ul>
        @foreach (var item in Model.Items)
        {
            <li>@item.Name (@item.Type, @item.Rarity, Power @item.Power)</li>
        }
        </ul>
    </div>

    <div class="build-sub-section">
        <h3>Ratings</h3>
        @if (Model.Ratings.Count == 0)
        {
            <p>No ratings yet.</p>
        }
        else
        {
            <ul class="build-rating-list">
            @foreach (var rating in Model.Ratings.OrderByDescending(r => r.CreatedAt))
            {
                var raterName = string.IsNullOrWhiteSpace(rating.User?.Username)
                    ? "Unknown"
                    : rating.User.Username;

                <li class="build-rating-card">
                    <div class="build-rating-user">@raterName</div>
                    <div class="build-rating-body">
                        <span class="build-rating-stars" aria-label="@rating.Score out of 5">
                            @for (var i = 1; i <= 5; i++)
                            {
                                var starClass = i <= rating.Score
                                    ? "build-rating-star build-rating-star--filled"
                                    : "build-rating-star";
                                <span class="@starClass">&#9733;</span>
                            }
                        </span>
                        <span class="build-rating-comment">@rating.Comment</span>
                    </div>
                </li>
            }
            </ul>
        }
    </div>
</section>
