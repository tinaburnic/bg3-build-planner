@model BG3BuildPlanner.Data.Build

@{
    ViewData["Title"] = "Build Details";
    var characterName = string.IsNullOrWhiteSpace(Model.Character?.Name)
        ? "Unknown"
        : Model.Character.Name;
    var creatorName = string.IsNullOrWhiteSpace(Model.User?.Username)
        ? "Unknown"
        : Model.User.Username;
    var difficultyImage = Model.Difficulty switch
    {
        Difficulty.Explorer => "Explorer_Difficulty.jpg",
        Difficulty.Balanced => "Balanced_Difficulty.jpg",
        Difficulty.Tactician => "Tactician_Difficulty.jpg",
        _ => "Balanced_Difficulty.jpg"
    };
    var currentUserIdValue = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var currentUserId = int.TryParse(currentUserIdValue, out var parsedCurrentUserId)
        ? parsedCurrentUserId
        : (int?)null;
    var isOwner = currentUserId.HasValue && currentUserId.Value == Model.UserId;
    var currentUserRating = currentUserId.HasValue
        ? Model.Ratings.FirstOrDefault(r => r.UserId == currentUserId.Value)
        : null;
    var canRateBuild = User.Identity?.IsAuthenticated == true && !isOwner;
}

<section class="build-detail-shell reveal-up fade-remove-target" aria-label="Build Details" data-remove-target>
    <span class="frame-corner frame-corner--tl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--tr" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--bl" aria-hidden="true"></span>
    <span class="frame-corner frame-corner--br" aria-hidden="true"></span>

    <p class="section-label">Build Breakdown</p>
    <h1 class="build-detail-title">@Model.Title</h1>

    <div class="build-detail-layout">
        <figure class="build-difficulty-panel">
            <img src="@Url.Content($"~/images/builds/{difficultyImage}")" alt="Image representing @Model.Difficulty difficulty" class="build-difficulty-image" />
            <figcaption class="build-difficulty-caption">@Model.Difficulty Difficulty</figcaption>
        </figure>

        <article class="build-detail-card" aria-label="Build Stats">
            <header class="build-detail-card-header">
                <p class="section-label mb-1">Details</p>
                <h2>@Model.Title</h2>
            </header>

            <dl class="build-stat-table">
                <div class="build-stat-row">
                    <dt>Description</dt>
                    <dd>@Model.Description</dd>
                </div>
                <div class="build-stat-row">
                    <dt>Difficulty</dt>
                    <dd>@Model.Difficulty</dd>
                </div>
                <div class="build-stat-row">
                    <dt>Character</dt>
                    <dd>@characterName</dd>
                </div>
                <div class="build-stat-row">
                    <dt>Created By</dt>
                    <dd>
                        @if (Model.User != null)
                        {
                            <a asp-controller="Users" asp-action="Details" asp-route-id="@Model.User.Id" class="creator-link">@creatorName</a>
                        }
                        else
                        {
                            @creatorName
                        }
                    </dd>
                </div>
                <div class="build-stat-row">
                    <dt>Created</dt>
                    <dd>@Model.CreatedAt.ToString("MMMM dd, yyyy")</dd>
                </div>
            </dl>
            <div class="build-detail-actions">
                @if (User.IsInRole("Admin") || isOwner)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-gold">Edit Build</a>
                }
                @if (User.IsInRole("Admin") || isOwner)
                {
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="build-detail-delete" data-delete-form data-delete-target=".build-detail-shell">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-outline-gold" onclick="return confirm('Delete this build?');">Delete Build</button>
                    </form>
                }
                <a asp-action="Index" class="btn-outline-gold">Back to Build List</a>
            </div>
        </article>
    </div>

    <div class="build-sub-section">
        <h3>Skills</h3>
        <ul class="skill-list">
        @foreach (var skill in Model.Skills)
        {
            <li class="skill-item">
                <figure class="skill-thumbnail-wrapper">
                    <img src="@Url.Content(skill.ImageUrl)" alt="@skill.Name" class="skill-thumbnail" />
                </figure>
                <div class="skill-info">
                    <a asp-controller="Skill" asp-action="Details" asp-route-id="@skill.Id" class="skill-name-link">@skill.Name</a>
                    <span class="skill-level">Level @skill.RequiredLevel</span>
                </div>
            </li>
        }
        </ul>
    </div>

    <div class="build-sub-section">
        <h3>Items</h3>
        <ul class="item-list">
        @foreach (var item in Model.Items)
        {
            var typeSymbol = item.Type switch
            {
                ItemType.Weapon => "⚔️",
                ItemType.Armor => "🛡️",
                ItemType.Accessory => "💍",
                _ => "•"
            };
            var rarityClass = $"item-rarity-{item.Rarity.ToLowerInvariant().Replace(" ", "-")}";

            <li class="item-item">
                <div class="item-header">
                    <a asp-controller="Item" asp-action="Details" asp-route-id="@item.Id" class="item-name-link">@item.Name</a>
                </div>
                <div class="item-meta">
                    <span class="item-type-badge" title="@item.Type">@typeSymbol @item.Type</span>
                    <span class="item-rarity-badge @rarityClass">@item.Rarity</span>
                    <span class="item-power">Power @item.Power</span>
                </div>
            </li>
        }
        </ul>
    </div>

    <div class="build-sub-section">
        <h3>Ratings</h3>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="build-rating-editor">
                @if (currentUserRating != null)
                {
                    <h4>Your Rating</h4>
                    <form id="rating-form" class="rating-form" data-mode="edit" data-rating-id="@currentUserRating.Id" data-build-id="@Model.Id">
                        <div class="rating-form-fields">
                            <div class="rating-form-field">
                                <label for="rating-score">Score</label>
                                <select id="rating-score" name="score" class="form-select">
                                    @for (var i = 1; i <= 5; i++)
                                    {
                                        if (currentUserRating.Score == i)
                                        {
                                            <option value="@i" selected="selected">@i</option>
                                        }
                                        else
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="rating-form-field rating-form-field--full">
                                <label for="rating-comment">Comment</label>
                                <textarea id="rating-comment" name="comment" class="form-control" rows="3">@currentUserRating.Comment</textarea>
                            </div>
                        </div>
                        <div class="build-detail-actions rating-form-actions">
                            <button type="submit" class="btn-gold">Save Rating</button>
                            <button type="button" class="btn-outline-gold" id="rating-delete-button" data-rating-id="@currentUserRating.Id">Delete Rating</button>
                        </div>
                        <p class="rating-form-status" id="rating-form-status" aria-live="polite"></p>
                    </form>
                }
                else if (canRateBuild)
                {
                    <h4>Rate This Build</h4>
                    <form id="rating-form" class="rating-form" data-mode="create" data-build-id="@Model.Id">
                        <div class="rating-form-fields">
                            <div class="rating-form-field">
                                <label for="rating-score">Score</label>
                                <select id="rating-score" name="score" class="form-select">
                                    @for (var i = 5; i >= 1; i--)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>
                            <div class="rating-form-field rating-form-field--full">
                                <label for="rating-comment">Comment</label>
                                <textarea id="rating-comment" name="comment" class="form-control" rows="3" placeholder="Share what worked, what didn’t, or why you rated it this way."></textarea>
                            </div>
                        </div>
                        <div class="build-detail-actions rating-form-actions">
                            <button type="submit" class="btn-gold">Submit Rating</button>
                        </div>
                        <p class="rating-form-status" id="rating-form-status" aria-live="polite"></p>
                    </form>
                }
                else
                {
                    <p>You cannot rate your own build.</p>
                }
            </div>
        }
        @if (Model.Ratings.Count == 0)
        {
            <p>No ratings yet.</p>
        }
        else
        {
            <ul class="build-rating-list">
            @foreach (var rating in Model.Ratings.OrderByDescending(r => r.CreatedAt))
            {
                var raterName = string.IsNullOrWhiteSpace(rating.User?.Username)
                    ? "Unknown"
                    : rating.User.Username;

                <li class="build-rating-card">
                    <div class="build-rating-user">@raterName</div>
                    <div class="build-rating-body">
                        <span class="build-rating-stars" aria-label="@rating.Score out of 5">
                            @for (var i = 1; i <= 5; i++)
                            {
                                var starClass = i <= rating.Score
                                    ? "build-rating-star build-rating-star--filled"
                                    : "build-rating-star";
                                <span class="@starClass">&#9733;</span>
                            }
                        </span>
                        <span class="build-rating-comment">@rating.Comment</span>
                    </div>
                </li>
            }
            </ul>
        }
    </div>
</section>

<style>
    .skill-list {
        padding: 0;
        margin: 0;
    }

    .skill-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        list-style: none;
        margin-bottom: 0.75rem;
    }

    .skill-thumbnail-wrapper {
        margin: 0;
        padding: 0;
        flex-shrink: 0;
    }

    .skill-thumbnail {
        display: block;
        width: 60px;
        height: 60px;
        object-fit: cover;
        border: 1px solid rgba(240, 225, 180, 0.3);
        border-radius: 4px;
    }

    .skill-info {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex-grow: 1;
    }

    .skill-name-link {
        color: inherit;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .skill-name-link:hover {
        color: #f0e1b4;
    }

    .skill-level {
        font-size: 0.875rem;
        color: rgba(240, 225, 180, 0.8);
    }

    .item-list {
        padding: 0;
        margin: 0;
    }

    .item-item {
        list-style: none;
        margin-bottom: 1rem;
        padding: 0.75rem;
        border: 1px solid rgba(240, 225, 180, 0.2);
        border-radius: 4px;
        background: rgba(240, 225, 180, 0.05);
    }

    .item-header {
        margin-bottom: 0.5rem;
    }

    .item-name-link {
        color: #f0e1b4;
        text-decoration: none;
        font-weight: 700;
        font-size: 1.05rem;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .item-name-link:hover {
        color: #fdf4d9;
    }

    .item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.875rem;
    }

    .item-type-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.25rem 0.5rem;
        background: rgba(240, 225, 180, 0.15);
        border: 1px solid rgba(240, 225, 180, 0.3);
        border-radius: 3px;
        font-weight: 600;
    }

    .item-rarity-badge {
        display: inline-block;
        padding: 0.25rem 0.5rem;
        border-radius: 3px;
        font-weight: 600;
        border: 1px solid;
    }

    /* Rarity gradients - from subtle to vibrant gold */
    .item-rarity-common {
        background: linear-gradient(135deg, rgba(200, 180, 100, 0.3), rgba(200, 180, 100, 0.2));
        color: rgba(200, 180, 100, 0.9);
        border-color: rgba(200, 180, 100, 0.4);
    }

    .item-rarity-uncommon {
        background: linear-gradient(135deg, rgba(220, 195, 110, 0.4), rgba(220, 195, 110, 0.3));
        color: rgba(220, 195, 110, 0.95);
        border-color: rgba(220, 195, 110, 0.5);
    }

    .item-rarity-rare {
        background: linear-gradient(135deg, rgba(240, 215, 120, 0.5), rgba(240, 215, 120, 0.4));
        color: rgba(240, 215, 120, 1);
        border-color: rgba(240, 215, 120, 0.6);
    }

    .item-rarity-very-rare {
        background: linear-gradient(135deg, rgba(240, 225, 130, 0.6), rgba(240, 225, 130, 0.5));
        color: #f0e182;
        border-color: rgba(240, 225, 130, 0.7);
    }

    .item-rarity-legendary {
        background: linear-gradient(135deg, #f0e1b4, rgba(240, 225, 180, 0.8));
        color: #ffffff;
        border-color: #f0e1b4;
    }

    .item-rarity-artifact {
        background: linear-gradient(135deg, #fdf4d9, #f0e1b4);
        color: #000000;
        border-color: #fdf4d9;
        font-weight: 700;
    }

    .item-power {
        font-size: 0.8rem;
        color: rgba(240, 225, 180, 0.7);
        font-style: italic;
    }

    .creator-link {
        color: inherit;
        text-decoration: none;
        cursor: pointer;
        transition: color 0.2s ease;
    }

    .creator-link:hover {
        color: #f0e1b4;
    }

    .build-rating-editor {
        margin-bottom: 1rem;
        padding: 0.75rem;
        border: 1px solid rgba(240, 225, 180, 0.18);
        border-radius: 4px;
        background: rgba(240, 225, 180, 0.04);
    }

    .rating-form h4 {
        margin-bottom: 0.75rem;
    }

    .rating-form-fields {
        display: grid;
        grid-template-columns: minmax(0, 120px) minmax(0, 1fr);
        gap: 0.85rem;
        align-items: start;
    }

    .rating-form-field {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .rating-form-field--full {
        grid-column: 1 / -1;
    }

    .rating-form label {
        color: var(--ink-ivory);
        font-weight: 600;
    }

    .rating-form .form-control,
    .rating-form .form-select {
        background-color: rgba(10, 9, 8, 0.92);
        color: var(--ink-ivory);
        border-color: rgba(240, 225, 180, 0.28);
    }

    .rating-form .form-control:focus,
    .rating-form .form-select:focus {
        border-color: rgba(240, 225, 180, 0.6);
        box-shadow: 0 0 0 0.1rem #000, 0 0 0 0.22rem rgba(216, 179, 106, 0.35);
    }

    .rating-form-actions {
        margin-top: 0.9rem;
    }

    .rating-form-status {
        margin: 0.65rem 0 0;
        color: rgba(240, 225, 180, 0.82);
        min-height: 1.2rem;
    }

</style>

@if (User.Identity?.IsAuthenticated == true)
{
    <script>
        (function () {
            const ratingForm = document.getElementById("rating-form");
            if (!ratingForm) {
                return;
            }

            const statusElement = document.getElementById("rating-form-status");
            const deleteButton = document.getElementById("rating-delete-button");
            const scoreElement = document.getElementById("rating-score");
            const commentElement = document.getElementById("rating-comment");
            const mode = ratingForm.dataset.mode;
            const buildId = Number(ratingForm.dataset.buildId);
            const ratingId = Number(ratingForm.dataset.ratingId || 0);

            const setStatus = (message, isError = false) => {
                if (!statusElement) {
                    return;
                }

                statusElement.textContent = message;
                statusElement.style.color = isError ? "#f4a6a6" : "rgba(240, 225, 180, 0.82)";
            };

            const readValidationErrors = async (response) => {
                try {
                    const data = await response.json();
                    if (data && data.errors) {
                        return Object.values(data.errors).flat().join(" ");
                    }
                } catch {
                    return "";
                }

                return "";
            };

            ratingForm.addEventListener("submit", async (event) => {
                event.preventDefault();

                const payload = {
                    score: Number(scoreElement.value),
                    comment: commentElement.value.trim(),
                    buildId
                };

                try {
                    const response = await fetch(mode === "edit" ? `/api/ratings/${ratingId}` : "/api/ratings", {
                        method: mode === "edit" ? "PUT" : "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        credentials: "same-origin",
                        body: JSON.stringify(payload)
                    });

                    if (!response.ok) {
                        const validationMessage = await readValidationErrors(response);
                        setStatus(validationMessage || "Unable to save rating.", true);
                        return;
                    }

                    location.reload();
                } catch {
                    setStatus("Unable to save rating.", true);
                }
            });

            if (deleteButton) {
                deleteButton.addEventListener("click", async () => {
                    if (!confirm("Delete your rating?")) {
                        return;
                    }

                    try {
                        const response = await fetch(`/api/ratings/${ratingId}`, {
                            method: "DELETE",
                            credentials: "same-origin"
                        });

                        if (!response.ok) {
                            setStatus("Unable to delete rating.", true);
                            return;
                        }

                        location.reload();
                    } catch {
                        setStatus("Unable to delete rating.", true);
                    }
                });
            }
        })();
    </script>
}
